# ---------------------------------------------------------------------------
# PLANTILLA. Para el taller NO hace falta: tu llave desechable llega como
# secreto de tu Codespace, no como archivo. Ver `00-preparacion-del-entorno.md`.
#
# Esto queda por si alguien quiere seguir usando el proyecto después del taller
# —en su propio computador, con su propia llave— cuando la del taller ya esté
# eliminada. En ese caso: copia este archivo a `.env` y llena los valores.
# ---------------------------------------------------------------------------

# Proveedor del modelo: "anthropic" (Claude API directa) o "bedrock".
# El agente, las herramientas y el prompt son idénticos en los dos casos.
PROVEEDOR_LLM=anthropic

# --- Camino A: Claude API directa (el del taller) ---------------------------
# En este camino el id va SIN el prefijo `anthropic.`: ese prefijo es exclusivo
# de Bedrock. Pon tu llave acá abajo.
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL_ID=claude-sonnet-5

# --- Camino B: Amazon Bedrock -----------------------------------------------
# Pon PROVEEDOR_LLM=bedrock. Las credenciales salen de la cadena estándar de AWS
# (perfil, variables de entorno o rol): no hay campo de API key en la aplicación,
# y es a propósito — una llave escrita en un formulario termina en capturas de
# pantalla y en el historial del navegador.
AWS_REGION=us-east-1
# En Bedrock el id SÍ lleva el prefijo del proveedor. Si tu cuenta exige perfil
# de inferencia entre regiones, usa "us.anthropic.claude-sonnet-5".
BEDROCK_MODEL_ID=anthropic.claude-sonnet-5

# --- El supuesto del negocio ------------------------------------------------
# No es una medición del archivo: es lo que vale la resina. Se puede cambiar en
# vivo desde la barra lateral, que es donde tiene que estar cuando alguien de la
# sala diga "ese precio no es el nuestro".
PRECIO_RESINA_USD_KG=1.85

# --- Los umbrales del análisis ----------------------------------------------
# CUIDADO: estos valores tienen que coincidir con los que se usaron al generar
# los datos. Los patrones están sembrados justo por encima de ellos, así que
# moverlos hacia arriba puede hacer desaparecer una lección entera sin que nada
# falle ni ninguna prueba se ponga roja.
#
# Ejemplo concreto: el lote sospechoso tiene poco más de 20 turnos. Con
# MIN_TURNOS_LOTE=25 quedaría descartado por muestra insuficiente y el asistente
# respondería, correctamente, que no hay ningún lote con evidencia.
#
# Muévelos para *ver qué pasa* — es un buen ejercicio — pero vuelve a estos.
MIN_TURNOS_LOTE=10
TOLERANCIA_PESO_G=0.15
UMBRAL_DERIVA_G_DIA=0.01
UMBRAL_Z_ANOMALIA=3.5

# --- Agente 2: paradas no planeadas (iteración 3) ---------------------------
COSTO_HORA_PARO_COP=2000000
PROB_EXITO_PREVENTIVO=0.60
MIN_OCURRENCIAS_PATRON=3

# --- Opcional ---------------------------------------------------------------
# MODELO_EMBEDDINGS=intfloat/multilingual-e5-base

# Tema de la interfaz: oscuro | claro | auto
# «auto» sigue la preferencia del sistema operativo. Si lo cambias a «claro»,
# cambia tambien los colores de .streamlit/config.toml: ese archivo es el que
# pinta los controles nativos de Streamlit y no lee esta variable.
TEMA=oscuro
