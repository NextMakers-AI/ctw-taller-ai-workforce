{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "allow": [
      "Bash(.venv/bin/python:*)",
      "Bash(.venv/bin/streamlit:*)",
      "Bash(.venv/bin/pip show:*)",
      "Bash(python -m:*)",
      "Bash(streamlit run:*)",

      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(find:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",

      "Bash(mkdir:*)",
      "Bash(cp referencia/:*)",
      "Bash(touch:*)"
    ],

    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push:*)",
      "Read(./.env)"
    ]
  }
}
